#!/usr/bin/env python3
"""Raise an app's existing window by WM_CLASS, else spawn its launcher.

The control daemon (control.py) only forwards allowlisted launchers here;
extra arguments are launch arguments. A matched window is raised instead of
spawning a duplicate; when arguments are present the launcher still runs first
(rakazo-browser forwards a URL into its live window) and the match is raised
after it exits.
"""

import os
import subprocess
import sys

# Launchers whose process WM_CLASS differs from the launcher name.
WM_CLASS = {"rakazo-browser": "chromium"}
WMCTRL_TIMEOUT_SEC = 5


def wm_class(launcher):
    """WM_CLASS substring for a launcher; X11 instance defaults to the binary basename."""
    return WM_CLASS.get(launcher, launcher.rsplit("/", 1)[-1]).lower()


def matching_window(listing, wm_class):
    """First `wmctrl -lx` row (id desktop wm_class host title) matching the class."""
    for line in listing.splitlines():
        fields = line.split(None, 4)
        if len(fields) >= 3 and wm_class in fields[2].lower():
            return fields[0]
    return ""


def main(argv):
    if not argv:
        raise SystemExit("usage: rakazo-focus-or-launch <launcher> [args...]")
    launcher, args = argv[0], argv[1:]
    try:
        listing = subprocess.run(
            ["wmctrl", "-lx"], capture_output=True, text=True, timeout=WMCTRL_TIMEOUT_SEC
        ).stdout
    except (OSError, subprocess.SubprocessError):
        listing = ""
    window = matching_window(listing, wm_class(launcher))
    if not window:
        os.execvp(launcher, [launcher, *args])
    if args:
        result = subprocess.run([launcher, *args])
        if result.returncode:
            raise SystemExit(result.returncode)
    os.execvp("wmctrl", ["wmctrl", "-ia", window])


if __name__ == "__main__":
    main(sys.argv[1:])
